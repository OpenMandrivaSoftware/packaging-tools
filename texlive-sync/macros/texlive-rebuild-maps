#!/bin/bash
# Assemble updmap.cfg from the header plus drop-ins in
# /usr/share/tlpkg/updmap.cfg.d/, then run updmap-sys to generate
# psfonts.map / pdftex.map / …
#
# Invoked by texlive-tlpkg filetriggers when a map fragment is added or
# removed. Do *not* use --syncwithtrees here: that comments out Map lines
# whose files are briefly missing and writes #! Map into /etc, which then
# overrides enabled maps in texmf-dist.
set -euo pipefail

TEXMFDIST="${TEXMFDIST:-/usr/share/texmf-dist}"
TEXMFSYSCONFIG="${TEXMFSYSCONFIG:-/etc/texmf}"
MAP_D="${MAP_D:-/usr/share/tlpkg/updmap.cfg.d}"
HDR="${TEXMFDIST}/web2c/updmap-hdr.cfg"
# Fallback: header-only copy shipped as updmap.cfg (Map lines stripped).
if [ ! -f "$HDR" ]; then
	HDR="${TEXMFDIST}/web2c/updmap.cfg"
fi
OUTDIR="${TEXMFSYSCONFIG}/web2c"
OUT="${OUTDIR}/updmap.cfg"

mkdir -p "${OUTDIR}"

{
	if [ -f "$HDR" ]; then
		# Keep everything that is not a Map/MixedMap/KanjiMap catalogue line.
		# The full TL updmap.cfg (from texlive-scripts) lists every map;
		# we only want options + comments from the header.
		awk '
			BEGIN { keep = 1 }
			/^(Map|MixedMap|KanjiMap)[[:space:]]/ { next }
			/^#![[:space:]]+(Map|MixedMap|KanjiMap)[[:space:]]/ { next }
			{ print }
		' "$HDR"
		echo
	fi
	echo "# ------------------------------------------------------------------"
	echo "# Maps from installed packages (/usr/share/tlpkg/updmap.cfg.d)."
	echo "# Generated by texlive-rebuild-maps; do not edit this block."
	echo "# ------------------------------------------------------------------"
	if [ -d "${MAP_D}" ]; then
		find "${MAP_D}" -maxdepth 1 -type f ! -name '.*' -print \
			| LC_ALL=C sort \
			| while IFS= read -r f; do
				[ -s "$f" ] || continue
				cat "$f"
				echo
			done
	fi
} > "${OUT}.tmp"
mv -f "${OUT}.tmp" "${OUT}"

if [ -x /usr/bin/updmap-sys ]; then
	# Generate psfonts.map etc. into TEXMFSYSVAR. Swallow "map file does
	# not exist" for Kanji @embed@ templates that need a jaEmbed choice.
	/usr/bin/updmap-sys --force >/dev/null 2>&1 || :
fi

if [ -x /usr/bin/mktexlsr ]; then
	/usr/bin/mktexlsr /var/lib/texmf >/dev/null 2>&1 || :
fi

exit 0
